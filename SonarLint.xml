<?xml version="1.0" encoding="UTF-8"?>
<!--
  Thresholds for the Sonar rules enforced on every C# project.
  The severities live in .editorconfig, the rationale in docs/CODE_RULES.md.
-->
<AnalysisInput>
  <Rules>
    <!-- S3776: cognitive complexity of a method. -->
    <Rule>
      <Key>S3776</Key>
      <Parameters>
        <Parameter>
          <Key>threshold</Key>
          <Value>13</Value>
        </Parameter>
        <Parameter>
          <Key>propertyThreshold</Key>
          <Value>3</Value>
        </Parameter>
      </Parameters>
    </Rule>
    <!-- S138: lines of code in a method. -->
    <Rule>
      <Key>S138</Key>
      <Parameters>
        <Parameter>
          <Key>max</Key>
          <Value>60</Value>
        </Parameter>
      </Parameters>
    </Rule>
    <!-- S107: parameters of a method. -->
    <Rule>
      <Key>S107</Key>
      <Parameters>
        <Parameter>
          <Key>max</Key>
          <Value>7</Value>
        </Parameter>
      </Parameters>
    </Rule>
    <!-- S134: nesting depth of control flow statements. -->
    <Rule>
      <Key>S134</Key>
      <Parameters>
        <Parameter>
          <Key>max</Key>
          <Value>3</Value>
        </Parameter>
      </Parameters>
    </Rule>
  </Rules>
</AnalysisInput>
