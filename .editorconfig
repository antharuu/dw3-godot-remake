root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# Enforce unused-using removal because imports should describe actual dependencies.
dotnet_diagnostic.IDE0005.severity = warning
# Enforce unused-value removal because ignored local computations conceal mistakes.
dotnet_diagnostic.IDE0059.severity = warning
# Enforce unused-parameter removal because private signatures must describe required input.
dotnet_diagnostic.IDE0060.severity = warning
# Enforce null-check simplification where the equivalent expression is clearer.
dotnet_diagnostic.IDE0031.severity = warning
# Enforce collection initializer simplification for concise, consistent construction.
dotnet_diagnostic.IDE0028.severity = warning
# Enforce collection expressions for consistent C# 12+ collection construction.
dotnet_diagnostic.IDE0300.severity = warning
# Enforce collection expressions for consistent C# 12+ empty collection construction.
dotnet_diagnostic.IDE0301.severity = warning
# Enforce collection expressions for consistent C# 12+ collection initialization.
dotnet_diagnostic.IDE0305.severity = warning

# Allow ignored expression values because fluent Godot APIs intentionally return values.
dotnet_diagnostic.IDE0058.severity = none
# Keep ordinary constructors because they make ownership and initialization explicit.
dotnet_diagnostic.IDE0290.severity = none
# Keep explicit Slice calls because range syntax is less legible in binary decoding code.
dotnet_diagnostic.IDE0057.severity = none
# Keep explicit variables because deconstruction can obscure binary-field meaning.
dotnet_diagnostic.IDE0042.severity = none
# Enforce unnecessary-suppression removal because suppressions must remain justified.
dotnet_diagnostic.IDE0079.severity = warning

# Keep explicit types in public and engine-facing code for readability at integration boundaries.
dotnet_diagnostic.IDE0007.severity = none
# Keep explicit types in public and engine-facing code for readability at integration boundaries.
dotnet_diagnostic.IDE0008.severity = none

# Code rules (docs/CODE_RULES.md). Thresholds live in SonarLint.xml and stylecop.json.
# Existing violations of these rules are tracked by the quality ratchet, new ones fail CI.
# Limit the cognitive complexity of a method so each one can be understood in one reading.
dotnet_diagnostic.S3776.severity = warning
# Limit the length of a method so each one does a single job.
dotnet_diagnostic.S138.severity = warning
# Limit the parameter count of a method so call sites stay legible.
dotnet_diagnostic.S107.severity = warning
# Limit the nesting depth of control flow so the happy path stays visible.
dotnet_diagnostic.S134.severity = warning
# One type per file, named after the type, so a type is found from its name.
dotnet_diagnostic.SA1402.severity = warning
dotnet_diagnostic.SA1649.severity = warning
# Document every element except private fields, so contributors read intent rather than reverse it.
dotnet_diagnostic.CS1591.severity = warning
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1611.severity = warning
dotnet_diagnostic.SA1615.severity = warning
dotnet_diagnostic.SA1623.severity = warning

# Conventions that differ from the StyleCop defaults (configuration, not suppression).
# Members are not prefixed with this., the compiler already resolves them and fields carry an underscore.
dotnet_diagnostic.SA1101.severity = none
# Private fields use the _camelCase convention of the .NET runtime repository.
dotnet_diagnostic.SA1309.severity = none
# No per-file copyright header, LICENSE.md covers the whole repository.
dotnet_diagnostic.SA1633.severity = none

# Tests document intent through their names, so the documentation completeness rules stop at tests/.
# Comments that are written in tests must still be well formed.
[tests/**.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1618.severity = none

# DW3001: custom class cognitive complexity analyser (tools/Dw3.Analyzers).
# Limit the total cognitive complexity of a class so each type can be understood without jumping between files.
dw3_class_cognitive_complexity_max = 50
