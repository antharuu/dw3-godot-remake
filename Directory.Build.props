<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(MSBuildProjectName)' != 'Dw3.Game'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Treat the selected .editorconfig style diagnostics as build errors. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The generated XML file enables IDE0005 during builds; documentation completeness remains outside this style gate. -->
    <NoWarn>$(NoWarn);1570;1573;1587;1591;1734</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- Pin SQLitePCLRaw native lib to a non-vulnerable version across all projects.
       SQLitePCLRaw.lib.e_sqlite3 2.1.10 (pulled by Microsoft.Data.Sqlite) has GHSA-2m69-gcr7-jv3q;
       2.1.14 includes the fix.  Applying globally so the audit check passes everywhere. -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
</Project>
