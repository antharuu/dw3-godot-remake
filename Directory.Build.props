<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(MSBuildProjectName)' != 'Dw3.Game'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep analyzer behavior stable while the existing code-style baseline is adopted.
         Code-style diagnostics stay editor suggestions until each rule is deliberately promoted. -->
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- Pin SQLitePCLRaw native lib to a non-vulnerable version across all projects.
       SQLitePCLRaw.lib.e_sqlite3 2.1.10 (pulled by Microsoft.Data.Sqlite) has GHSA-2m69-gcr7-jv3q;
       2.1.14 includes the fix.  Applying globally so the audit check passes everywhere. -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
</Project>
